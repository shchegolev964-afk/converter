# ------------------------------------------------------------------
# Скопируй этот файл в `.env` и заполни значения.
# `.env` в гит не коммитится (см. .gitignore).
# ------------------------------------------------------------------

# Токен бота, который выдаёт @BotFather в Telegram. Обязательно.
TELEGRAM_BOT_TOKEN=123456789:AA-replace-me

# Базовая валюта для команды /rates (по умолчанию USD).
BASE_CURRENCY=USD

# Время жизни кэша курсов в секундах (по умолчанию 60).
CACHE_TTL_SECONDS=60

# Уровень логирования: DEBUG / INFO / WARNING / ERROR.
LOG_LEVEL=INFO

# Прокси для api.telegram.org. Оставь пустым, если Telegram доступен напрямую.
# Примеры:
#   TELEGRAM_PROXY=http://user:pass@host:8080
#   TELEGRAM_PROXY=socks5://127.0.0.1:1080
# Для socks5 потребуется: pip install "httpx[socks]"
TELEGRAM_PROXY=
